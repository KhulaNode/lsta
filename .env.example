# Public site origin, including https:// and without a trailing slash.
# Set in Dokploy before building so generated canonical URLs and sitemap use the public hostname.
NEXT_PUBLIC_SITE_URL=https://lsta.khulanode.com

# Contact delivery. Set all required values in Dokploy; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO_EMAIL=info@limpoposcholartransportalliance.co.za
